{
  "manifest_version": 3,
  "name": "SYSTM 2 INTERVALS Calendar Sync",
  "short_name": "SYSTM2INTRVL",
  "icons": {
    "16": "media/icon_16.png",
    "32": "media/icon_32.png",
    "48": "media/icon_48.png",
    "128": "media/icon_128.png"
  },
  "version": "0.0.0.6",
  "description": "Sync Wahoo SYSTM calendar items to your intervals.icu account",
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/backgroundChrome.js"
  },
  "content_scripts": [
    {
      "js": ["calendar.js"],
      "css": ["options/options.css"],
      "matches": ["https://systm.wahoofitness.com/calendar*"]
    }
  ],
  "permissions": ["storage"],
  "key:": ""
}
